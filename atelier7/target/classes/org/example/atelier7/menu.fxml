<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.example.atelier7.controllers.MenuController"
            prefHeight="400.0" prefWidth="600.0">
    <VBox alignment="CENTER" spacing="15" layoutX="50" layoutY="30" prefWidth="300" prefHeight="200">
        <Label text="=== SYSTÈME DE GESTION ===" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

        <!-- Garde uniquement CE bouton -->
        <Button fx:id="connexionButton" text="Se connecter" onAction="#handleConnexion" />

        <Button text="S'inscrire" onAction="#handleInscription"/>
        <Button text="Quitter" onAction="#handleQuitter"/>
    </VBox>
</AnchorPane>
