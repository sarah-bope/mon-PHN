<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.example.atelier7.controllers.SupprimerProduitController"
            prefHeight="400.0" prefWidth="600.0">
    <VBox spacing="10" alignment="CENTER" style="-fx-padding: 20;">
        <Label text="Supprimer un produit"/>
        <TextField fx:id="idField" promptText="ID du produit"/>
        <Button text="Supprimer" onAction="#handleSupprimer"/>
        <Label fx:id="messageLabel"/>
    </VBox>
</AnchorPane>
